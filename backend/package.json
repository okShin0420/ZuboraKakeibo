{
  "name": "zubora-kakeibo-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "db:migrate:sqlite": "node scripts/migrate.js --dialect sqlite --direction up",
    "db:rollback:sqlite": "node scripts/migrate.js --dialect sqlite --direction down",
    "db:migrate:postgresql": "node scripts/migrate.js --dialect postgresql --direction up",
    "db:rollback:postgresql": "node scripts/migrate.js --dialect postgresql --direction down",
    "test": "node --test"
  },
  "dependencies": {
    "pg": "8.16.3"
  }
}
