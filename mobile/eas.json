{
  "cli": {
    "version": ">= 25.1.1",
    "appVersionSource": "remote",
    "promptToConfigurePushNotifications": false
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true
    },
    "startup-diagnostics": {
      "extends": "production",
      "env": {
        "EXPO_PUBLIC_STARTUP_DIAGNOSTICS": "1"
      }
    },
    "widget-static-diagnostics": {
      "extends": "production",
      "env": {
        "EXPO_WIDGET_STATIC_DIAGNOSTIC": "1"
      }
    },
    "widget-text-diagnostics": {
      "extends": "production",
      "env": {
        "EXPO_WIDGET_TEXT_DIAGNOSTIC": "1"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6823954494"
      }
    }
  }
}
