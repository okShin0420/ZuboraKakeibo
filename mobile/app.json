{
  "expo": {
    "name": "ズボラ家計簿",
    "slug": "zubora-kakeibo",
    "scheme": "zuborakakeibo",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/app-icon-dog-gradient.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.okshin0420.zuborakakeibo",
      "icon": "./assets/app-icon-dog-gradient.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#017AF4",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "OpenHomeWidgetV2",
              "displayName": "今月あと使えるお金",
              "description": "残額と残り日数を見て、ホームを開きます",
              "ios": {
                "supportedFamilies": ["accessoryRectangular"],
                "contentMarginsDisabled": true,
                "initialLayout": "./src/widgets/openHomeWidget.tsx"
              }
            }
          ]
        }
      ],
      "expo-sqlite",
      "expo-notifications",
      "expo-image",
      "expo-sharing",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "ios": {
            "backgroundColor": "#017AF4",
            "image": "./assets/ios-launch-screen.png",
            "resizeMode": "cover",
            "enableFullScreenImage_legacy": true
          }
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "ja"
            ]
          }
        }
      ],
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "eeee481a-3e33-4047-b0b8-a3e22365d7f1"
      }
    },
    "owner": "okshin0420"
  }
}
